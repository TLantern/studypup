{
  "expo": {
    "name": "Notario",
    "slug": "studypup",
    "version": "2.0.5",
    "orientation": "portrait",
    "icon": "./assets/images/notariomainicon.png",
    "scheme": "notario",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Notario needs local network access to connect to the development server for live reload.",
        "NSMicrophoneUsageDescription": "Notario uses the microphone to record lectures and study notes.",
        "NSCameraUsageDescription": "Notario uses the camera to capture notes and study materials.",
        "NSPhotoLibraryUsageDescription": "Notario needs access to your photos to import study materials and images.",
        "NSPhotoLibraryAddUsageDescription": "Notario saves recordings and captures to your photo library.",
        "NSUserTrackingUsageDescription": "Notario uses this to measure ad performance and improve your experience. Your data is never sold.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "icon": {
        "light": "./assets/images/notariomainicon.png",
        "dark": "./assets/images/notariomainicon.png",
        "tinted": "./assets/images/notariomainicon_tinted.png"
      },
      "bundleIdentifier": "com.teniola.studypup",
      "bitcode": false,
      "appleTeamId": "2VNNBBD2G9"
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#add8e6",
        "foregroundImage": "./assets/images/notariomainicon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.notario.app",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.INTERNET",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@config-plugins/react-native-webrtc",
      "./plugins/withWebRTCFix",
      "expo-firebase-core",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Notario needs access to your photos to import study materials and images.",
          "cameraPermission": "Notario uses the camera to capture notes and study materials.",
          "microphonePermission": "Notario uses the microphone to record lectures and study notes."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Notario needs access to your photos to import study materials and images.",
          "savePhotosPermission": "Notario saves recordings and captures to your photo library."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/splash-logo.png",
          "dark": {
            "image": "./assets/images/splash-logo.png",
            "backgroundColor": "#000000"
          },
          "imageWidth": 300
        }
      ],
      "expo-notifications",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 21
          },
          "ios": {
            "deploymentTarget": "15.1",
            "useFrameworks": "static"
          },
          "jsEngine": "hermes"
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.114632107142-skgnhps8drg13j4rqjag4ijhneg6o7pa"
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "73cf338b-2d1f-4987-926b-935e6f5863a4"
      }
    },
    "owner": "ten123"
  }
}
